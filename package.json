{
  "name": "@fishenv/http",
  "version": "0.0.2",
  "description": "Type-safe HTTP router for Bun with valibot validation, contracts and Server-Sent Events.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/mod.d.ts",
      "default": "./dist/core/mod.js"
    },
    "./sse": {
      "types": "./dist/sse/mod.d.ts",
      "default": "./dist/sse/mod.js"
    },
    "./contract": {
      "types": "./dist/contract/mod.d.ts",
      "default": "./dist/contract/mod.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "valibot": "^1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
